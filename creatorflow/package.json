{
  "name": "creatorflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -b && vite build",
    "build:ios": "node scripts/validate-ios-build.mjs && VITE_BASE_PATH=/ VITE_ROUTER_BASENAME=/ npm run build && npx cap sync ios",
    "build:android": "VITE_BASE_PATH=/ VITE_ROUTER_BASENAME=/ npm run build && npx cap sync android",
    "cap:sync": "npm run build:ios",
    "cap:sync:android": "npm run build:android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "postbuild": "cp dist/index.html dist/404.html",
    "prerender": "node scripts/prerender.mjs",
    "build:seo": "npm run build && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
