{
  "name": "creatorflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ios": "VITE_BASE_PATH=/ VITE_ROUTER_BASENAME=/ npm run build && npx cap sync ios",
    "build:android": "VITE_BASE_PATH=/ VITE_ROUTER_BASENAME=/ npm run build && npx cap sync android",
    "cap:sync": "npm run build:ios",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "postbuild": "cp dist/index.html dist/404.html",
    "prerender": "node scripts/prerender.mjs",
    "build:seo": "npm run build && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
