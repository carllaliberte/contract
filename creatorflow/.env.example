# CreatorFlow — variables publiques Vite (incluses au build).
# Ne jamais y mettre des clés OpenAI, Supabase service role, etc.
# Copy to .env.local for local development.

# URL de l'API scripts IA — URL complète de la Edge Function Supabase :
#   VITE_API_URL=https://TON-PROJET.supabase.co/functions/v1/generate-script
# Base API Hono / Render (vide = /ai/generate-script via Vite en local) :
VITE_API_URL=

# Apple Sign In (Supabase Edge Function, si différent de ${VITE_API_URL}/auth/apple) :
# VITE_AUTH_APPLE_URL=https://TON-PROJET.supabase.co/functions/v1/auth-apple

# Capacitor iOS build (racine /, pas le chemin GitHub Pages) :
# VITE_BASE_PATH=/
# VITE_ROUTER_BASENAME=/

# Dev/staging only — enables Apple auth stub when backend is unavailable (NEVER set for App Store release)
# VITE_AUTH_STUB=true
