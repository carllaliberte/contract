# CreatorFlow — variables publiques Vite (incluses au build).
# Ne jamais y mettre des clés OpenAI, Supabase service role, etc.
# Copy to .env.local for local development.

# URL de l'API scripts IA — URL complète de la Edge Function Supabase :
#   VITE_API_URL=https://TON-PROJET.supabase.co/functions/v1/generate-script
# Alternative Fly.io (base, sans slash final) :
#   VITE_API_URL=https://creatorflow-api.fly.dev
# Local Hono API (vide = /ai/generate-script via proxy Vite) :
VITE_API_URL=

# Supabase (authenticated idea persistence + JWT validation)
# Vides = démo (localStorage). Jamais de clés dans git.
# GitHub Actions: vars VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Apple Sign In (Supabase Edge Function, si différent de ${VITE_API_URL}/auth/apple) :
# VITE_AUTH_APPLE_URL=https://TON-PROJET.supabase.co/functions/v1/auth-apple

# IAP validation (defaults to ${VITE_API_URL}/iap/apple/validate when using Fly.io/Hono base URL)
# VITE_IAP_VALIDATE_URL=

# Capacitor iOS build (racine /, pas le chemin GitHub Pages) :
# VITE_BASE_PATH=/
# VITE_ROUTER_BASENAME=/

# Dev/staging only — enables Apple auth stub when backend is unavailable.
# FORBIDDEN for iOS App Store: npm run build:ios refuses the build if this is true.
# Native apps never use stub auth at runtime (see src/lib/api/auth.ts).
# VITE_AUTH_STUB=true
