# CreatorFlow — variables publiques Vite (incluses au build).
# Ne jamais y mettre des clés OpenAI, Supabase service role, etc.
# Copy to .env.local for local development.

# URL de l'API scripts IA (base, sans slash final).
# Production (Fly.io) :
VITE_API_URL=https://creatorflow-api.fly.dev
# Supabase Edge Function (alternative) :
# VITE_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/generate-script
# Local Hono API (vide = /ai/generate-script via proxy Vite) :
# VITE_API_URL=

# Supabase (authenticated idea persistence + JWT validation)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Capacitor iOS build (racine /, pas le chemin GitHub Pages) :
# VITE_BASE_PATH=/
# VITE_ROUTER_BASENAME=/

# Optional dedicated Sign in with Apple token exchange endpoint (defaults to ${VITE_API_URL}/auth/apple)
# VITE_AUTH_APPLE_URL=

# Optional dedicated IAP validation endpoint (defaults to ${VITE_API_URL}/iap/apple/validate)
# VITE_IAP_VALIDATE_URL=

# Dev/staging only — enables Apple auth stub when backend is unavailable.
# FORBIDDEN for iOS App Store: npm run build:ios refuses the build if this is true.
# Native apps never use stub auth at runtime (see src/lib/api/auth.ts).
# VITE_AUTH_STUB=true
