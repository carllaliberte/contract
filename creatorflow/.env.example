# CreatorFlow — variables publiques Vite (incluses au build).
# Ne jamais y mettre des clés OpenAI, Supabase service role, etc.
# Copy to .env.local for local development.

# URL de l'API scripts IA (base ou endpoint complet).
# Supabase Edge Function (full URL acceptée) :
#   VITE_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/generate-script
# Base API Hono / proxy local (vide = /ai/generate-script via Vite) :
VITE_API_URL=

# Production iOS release — point to your deployed API (never set VITE_AUTH_STUB)
# VITE_API_URL=https://your-api.example.com
# VITE_AUTH_STUB must remain unset for App Store builds

# Capacitor iOS build (racine /, pas le chemin GitHub Pages) :
# VITE_BASE_PATH=/
# VITE_ROUTER_BASENAME=/

# Optional dedicated Sign in with Apple token exchange endpoint (defaults to ${VITE_API_URL}/auth/apple)
# VITE_AUTH_APPLE_URL=

# Dev/staging only — enables Apple auth stub when backend is unavailable (NEVER set for App Store release)
# VITE_AUTH_STUB=true
