+function resolveWebRedirectUri(): string {
+  if (typeof window === "undefined") return APPLE_REDIRECT_URI;
+  const origin = window.location.origin;
+  const base = ROUTER_BASENAME === "/" ? "" : ROUTER_BASENAME;
+  return `${origin}${base}/auth/apple`;
